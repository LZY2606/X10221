    {
      "key": "polygon",
      "note": "上游门修订：Lymph 左边界右移（1.0 → 1.2），下游群体标记过期而不覆盖",
      "payload": {
        "gates": [
          {"gate_id": "G1", "x_channel": "FSC-A", "y_channel": "SSC-A", "basis": "transformed", "points": [[1.2, 1.0], [3.0, 1.0], [3.0, 3.0], [1.2, 3.0]]},
          {"gate_id": "G2", "x_channel": "FITC", "y_channel": "PE", "basis": "transformed", "points": [[2.0, 0.5], [4.0, 0.5], [4.0, 4.0], [2.0, 4.0]]}
        ]
      }
    },
    {
      "key": "hierarchy",
      "note": "门嵌套改名：FITC+ → FITC-pos，gate_id 不变，身份稳定",
      "payload": {
        "nodes": [
          {"gate_id": "G1", "name": "Lymph", "parent": null},
          {"gate_id": "G2", "name": "FITC-pos", "parent": "G1"}
        ]
      }
    },
