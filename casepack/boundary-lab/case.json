        {"id": "e04", "values": {"FSC-A": {"raw": "150", "value": 150.0, "unit": "RFU", "basis": "acquisition"}, "SSC-A": {"raw": "15000", "value": 15000.0, "unit": "RFU", "basis": "acquisition"}, "FITC": {"raw": "150000", "value": 150000.0, "unit": "RFU", "basis": "acquisition"}, "PE": {"raw": "15000", "value": 15000.0, "unit": "RFU", "basis": "acquisition"}}},
