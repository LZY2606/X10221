  "scenarios": [
    {
      "id": "scn-near-singular",
      "title": "Near-singular compensation matrix",
      "description": "Replace spillover fit with a near-collinear matrix; inverse must not be silently taken.",
      "steps": [
        {
          "type": "revise-matrix",
          "matrix": {
            "id": "matrix-v2-singular",
            "spillover_id": "spill-1",
            "coefficients": [
              [
                1.0,
                0.999999
              ],
              [
                1.000001,
                1.0
              ]
            ],
            "basis_note": "faulty refit: detector rows nearly collinear; determinant ~ -1e-6"
          }
        }
      ]
    },
    {
      "id": "scn-transform",
      "title": "Transform parameter revision",
      "description": "Change asinh cofactor 150 -> 300; only asinh gates and descendants go stale.",
      "steps": [
        {
          "type": "revise-transform",
          "transform": {
            "id": "xform-v2",
            "kind": "asinh",
            "cofactor": 300.0,
            "output_unit": "asinh-scaled ADC (cofactor 300)",
            "applies_to": [
              "FL1-A",
              "FL2-A"
            ]
          }
        }
      ]
    },
    {
      "id": "scn-local-patch",
      "title": "Local source data patch",
      "description": "Move one fluorescence event; only FL gate subtree is invalidated, FSC gates untouched.",
      "steps": [
        {
          "type": "patch-source",
          "reason": "FL1 detector gain re-calibrated for e07",
          "changes": [
            {
              "event_id": "e07",
              "channel_id": "FL1-A",
              "new_raw_text": "800"
            }
          ]
        }
      ]
    },
    {
      "id": "scn-rename-gate",
      "title": "Gate nested rename",
      "description": "Revise and rename the nested FL gate; logical identity and parent relations survive.",
      "steps": [
        {
          "type": "revise-gate",
          "gate": {
            "logical_id": "g_flpos",
            "version_id": "g_flpos@2",
            "name": "FITC+ (renamed: FITC positive gate)",
            "x": {
              "channel_id": "FL1-A",
              "space": "CompensatedAsinh",
              "matrix_id": "matrix-v2-singular",
              "transform_id": "xform-v1"
            },
            "y": {
              "channel_id": "FL2-A",
              "space": "CompensatedAsinh",
              "matrix_id": "matrix-v2-singular",
              "transform_id": "xform-v1"
            },
            "polygon": [
              [
                150,
                -300
              ],
              [
                1100,
                -300
              ],
              [
                1100,
                1100
              ],
              [
                150,
                1100
              ]
            ],
            "boundary_rule": "include"
          }
        }
      ]
    }
  ]
